# Stage: development | production | test
NODE_ENV="development"

# API, read at build time (the /api rewrites)
API_URL=""                # optional, the Oreo API the /api/v1 routes proxy to (defaults to http://localhost:5050)

# Site
PUBLIC_BASE_URL=""        # optional, this site's origin for canonical, Open Graph & sitemap URLs, e.g. https://oreo.aniket.zip (defaults to http://localhost:3100)
NEXT_PUBLIC_PREMIUM=""    # optional, 'true' shows premium: its page, buy & claim buttons, upsells and guide pages (defaults to hidden)